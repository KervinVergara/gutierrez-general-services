rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quotes/{id} {
      // Anyone can submit a quote request from the landing page (only the expected fields).
      allow create: if request.resource.data.keys().hasOnly(['type','name','phone','email','zip','service','vehicle','message','lang','status','createdAt','userAgent'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() > 5 && request.resource.data.phone.size() < 40
                    && request.resource.data.message.size() < 2000
                    && request.resource.data.status == 'new';
      // Only signed-in staff can read/update/delete.
      allow read, update, delete: if request.auth != null;
    }
    match /feedback/{id} {
      // Temporary dev-stage widget: anyone with the site link can submit, check off and remove
      // change requests. Free-text notes only, no sensitive data stored here.
      allow create: if request.resource.data.keys().hasOnly(['text','status','createdAt'])
                    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 2000
                    && request.resource.data.status == 'pending';
      allow read, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'done'];
    }
  }
}
