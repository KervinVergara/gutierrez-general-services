rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real authorization boundary: signed in AND carrying the "admin" custom claim
    // (see scripts/set-admin-claim.mjs). A signed-in account without the claim must
    // be treated the same as anonymous for every internal collection.
    function isStaff() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // True when `field` either wasn't present before, or is present in the new
    // document with the exact same value it had before. Used to stop a staff
    // account from rewriting history fields (createdAt, origin) on `update`,
    // even though staff can freely edit the rest of the document.
    function unchanged(field) {
      return !(field in resource.data)
             || (field in request.resource.data && request.resource.data[field] == resource.data[field]);
    }

    // Forces every create/update on the audited internal collections to
    // stamp who made it, as their OWN uid — a client can truthfully claim
    // "I did this", never "someone else did this". A Cloud Functions
    // trigger reads updatedBy off these writes to build an audit trail in
    // /auditLog. Doesn't apply to delete (there's no new document to check
    // against), so a delete's actor isn't captured this way — see
    // functions/index.js and the project notes for that limitation.
    function stampedActor() {
      return request.resource.data.updatedBy == request.auth.uid;
    }

    match /quotes/{id} {
      // Public submissions now go through the submitQuote Cloud Function
      // (functions/index.js), which validates + rate-limits server-side and
      // writes via the Admin SDK — the Admin SDK bypasses these rules
      // entirely, so no client-facing "allow create" is needed for that
      // path anymore. Only staff can create directly (e.g. a phone-in lead
      // entered manually), and only staff can read/delete; updates
      // additionally can't rewrite createdAt.
      allow create, read, delete: if isStaff();
      allow update: if isStaff() && unchanged('createdAt');
    }
    match /feedback/{id} {
      // Dev-stage widget for Kervin's own change-request notes — currently
      // unmounted from the public site (see Landing.jsx), so there's no UI
      // that calls the old public "create" path anymore. It's closed off
      // entirely rather than kept open-but-unused: an open public write
      // path with no rate limit of its own was reachable directly via the
      // SDK/REST API even with nothing on the page linking to it. If the
      // widget comes back for real customers, route submissions through a
      // Cloud Function (same pattern as submitQuote: rate limit, honeypot,
      // payload cap) instead of reopening this rule.
      allow read, create, delete: if isStaff();
      // Staff can only flip status — text/createdAt can never be edited this way, so the
      // hasOnly(['status']) check already makes createdAt/text immutable on update.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'done'];
    }
    match /clients/{id} {
      // Internal CRM data — only signed-in staff can read/write; updates can't rewrite createdAt.
      // Create/update must be honestly attributed to the account making them (stampedActor).
      // Deletes are NOT allowed here — only the deleteRecord Cloud Function can
      // delete these, so a delete is always attributed to the real staff uid
      // that made it (see functions/index.js). See auditLog below.
      allow read: if isStaff();
      allow create: if isStaff() && stampedActor();
      allow update: if isStaff() && unchanged('createdAt') && stampedActor();
    }
    match /jobs/{id} {
      // Completed/scheduled service records — only signed-in staff; updates can't rewrite
      // createdAt or origin (whether the job came from a quote, a plan, or manual entry).
      // Deletes are NOT allowed here — only the deleteRecord Cloud Function can
      // delete these, so a delete is always attributed to the real staff uid
      // that made it (see functions/index.js). See auditLog below.
      allow read: if isStaff();
      allow create: if isStaff() && stampedActor();
      allow update: if isStaff() && unchanged('createdAt') && unchanged('origin') && stampedActor();
    }
    match /finance/{id} {
      // Income/expense ledger — only signed-in staff; updates can't rewrite createdAt.
      // Deletes are NOT allowed here — only the deleteRecord Cloud Function can
      // delete these, so a delete is always attributed to the real staff uid
      // that made it (see functions/index.js). See auditLog below.
      allow read: if isStaff();
      allow create: if isStaff() && stampedActor();
      allow update: if isStaff() && unchanged('createdAt') && stampedActor();
    }
    match /plans/{id} {
      // Recurring maintenance plans — only signed-in staff; updates can't rewrite createdAt.
      // Deletes are NOT allowed here — only the deleteRecord Cloud Function can
      // delete these, so a delete is always attributed to the real staff uid
      // that made it (see functions/index.js). See auditLog below.
      allow read: if isStaff();
      allow create: if isStaff() && stampedActor();
      allow update: if isStaff() && unchanged('createdAt') && stampedActor();
    }
    match /auditLog/{id} {
      // Written only by Cloud Functions (audit_* triggers + deleteRecord),
      // via the Admin SDK (which bypasses these rules entirely) — never
      // directly by a client, so a compromised admin session can't edit or
      // erase its own trail. Entries carry an expiresAt (2 years) backing a
      // Firestore TTL policy configured in the console, so old entries
      // (which can include past client contact info in before/after) don't
      // accumulate forever.
      allow read: if isStaff();
    }
    // rateLimits is intentionally left with no match block above (default
    // deny) — only functions/index.js's Admin SDK ever touches it.
  }
}
