rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only accounts explicitly granted the "admin" custom claim count as staff.
    // Being signed in is NOT enough on its own — see scripts/set-admin-claim.mjs
    // for how that claim gets assigned. This is what actually separates a
    // regular Firebase Auth account from someone who can touch the CRM.
    function isStaff() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /quotes/{id} {
      // Anyone can submit a quote request from the landing page (only the expected fields).
      allow create: if request.resource.data.keys().hasOnly(['type','name','phone','email','zip','service','vehicle','message','lang','status','createdAt','userAgent'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() > 5 && request.resource.data.phone.size() < 40
                    && request.resource.data.message.size() < 2000
                    && request.resource.data.status == 'new';
      // Signed-in staff can also create a quote manually (e.g. a phone-in lead), with extra fields.
      allow create: if isStaff();
      // Only staff (admin custom claim) can read/update/delete.
      allow read, update, delete: if isStaff();
    }
    match /feedback/{id} {
      // Dev-stage widget: anyone with the site link can submit a change request (write-only,
      // free-text notes, no sensitive data). Reading/checking off/removing entries is staff-only —
      // previously this was world-readable and world-deletable, which let anyone on the internet
      // see or wipe the whole feedback list.
      allow create: if request.resource.data.keys().hasOnly(['text','status','createdAt'])
                    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 2000
                    && request.resource.data.status == 'pending';
      allow read, delete: if isStaff();
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'done'];
    }
    match /clients/{id} {
      // Internal CRM data — staff only.
      allow read, create, update, delete: if isStaff();
    }
    match /jobs/{id} {
      // Completed/scheduled service records — staff only.
      allow read, create, update, delete: if isStaff();
    }
    match /finance/{id} {
      // Income/expense ledger — staff only.
      allow read, create, update, delete: if isStaff();
    }
    match /plans/{id} {
      // Recurring maintenance plans — staff only.
      allow read, create, update, delete: if isStaff();
    }
  }
}
